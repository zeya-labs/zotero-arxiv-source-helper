{
  "manifest_version": 2,
  "name": "arXiv Source Helper",
  "version": "0.1.4",
  "description": "Automatically retain arXiv TeX source and expose local section/table queries.",
  "author": "Zeya",
  "homepage_url": "https://github.com/zeya-labs/zotero-arxiv-source-helper",
  "applications": {
    "zotero": {
      "id": "arxiv-source-helper@local.research",
      "update_url": "https://raw.githubusercontent.com/zeya-labs/zotero-arxiv-source-helper/main/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
